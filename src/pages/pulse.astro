---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PulseDemo from "../components/PulseDemo.astro";
import { CONTACT_EMAIL, PULSE_BASE, SITE_TITLE, X_HANDLE, X_URL } from "../consts";

const cron = `0 3 * * * /usr/local/bin/backup.sh && \\
  curl -fsS -X POST -H "Authorization: Bearer $NANO_API_KEY" \\
    ${PULSE_BASE}/v1/ping/nightly-backup`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`NanoPulse — ${SITE_TITLE}`}
			description="NanoPulse tells you when a job you depend on has stopped running. Your job pings on success; silence is the alert."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<p class="eyebrow">nano-api / pulse</p>
					<h1>Your backup job died at 03:14.<br /><span class="dim">Nobody noticed until Monday.</span></h1>
					<p class="lede">
						Your job pings us when it succeeds. When the ping stops arriving, we tell you — in
						Slack, within a minute.
					</p>
					<p class="cta">
						<a class="button" href={`mailto:${CONTACT_EMAIL}?subject=nano-api%20key`}>Get a free API key</a>
						<a class="button secondary" href="/howto/#pulse">Curl walkthrough</a>
					</p>
					<p class="fineprint muted">
						Free. Mail <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or ping
						<a href={X_URL} rel="noopener" target="_blank">{X_HANDLE}</a> on X.
					</p>
				</div>
				<PulseDemo />
			</section>

			<section class="band">
				<h2>One line in your crontab</h2>
				<pre><code>{cron}</code></pre>
				<p class="muted small">
					The <code>&&</code> is the design: if the job fails, the ping never happens, and silence
					is what we alert on. First ping creates the monitor;
					<code>?interval=86400&amp;grace=3600</code> sets the window.
				</p>
			</section>

			<section class="band">
				<h2>Uptime checks watch the door. We watch the work.</h2>
				<div class="two">
					<div class="card">
						<p class="tag">Uptime monitoring</p>
						<ul class="plain">
							<li>Pings your server, sees HTTP 200</li>
							<li>Silent when the nightly export never ran</li>
							<li>Blind to queue workers, CronJobs, laptop scripts</li>
							<li>Needs your job reachable from the internet</li>
						</ul>
					</div>
					<div class="card alive-edge">
						<p class="tag live">NanoPulse</p>
						<ul class="plain">
							<li>Waits for the job itself to report success</li>
							<li>Alerts on absence — the failure nobody catches</li>
							<li>Works anywhere <code>curl</code> works</li>
							<li>Takes a payload: "12 043 rows exported"</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="band">
				<h2>How it works</h2>
				<ol class="steps">
					<li>
						<span class="n">1</span>
						<h3>Ping on success</h3>
						<p>One HTTP call at the end of the job. GET or POST.</p>
					</li>
					<li>
						<span class="n">2</span>
						<h3>We count</h3>
						<p>A sweep at the edge checks every minute who has gone quiet.</p>
					</li>
					<li>
						<span class="n">3</span>
						<h3>We shout once</h3>
						<p>On the way down, and again on recovery. Transitions only.</p>
					</li>
				</ol>
			</section>

			<section class="band">
				<h2>Pairs with the others</h2>
				<p>
					<a href="/relay/">Relay</a> runs the job for you; <a href="/lock/">Lock</a> keeps it to one
					copy. Put a ping at the end and a missing Relay run is an alert too.
				</p>
				<p class="cta">
					<a class="button" href="/howto/">How to, in curl</a>
					<a class="button secondary" href="/pricing/">What it costs</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 2.5em;
		align-items: center;
		padding: 2em 0 1em;
	}
	.dim {
		color: var(--muted);
	}
	.lede {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 34em;
	}
	.cta {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		margin: 1.4em 0 0.6em;
	}
	.fineprint {
		font-size: 0.85rem;
	}
	.band {
		padding: 3em 0 0;
	}
	.band > p {
		max-width: 46em;
		color: var(--muted);
	}
	.small {
		font-size: 0.85rem;
	}
	.two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2em;
		margin-top: 1.4em;
	}
	.alive-edge {
		border-color: var(--alive-dim);
	}
	ul.plain {
		list-style: none;
		margin: 1em 0 0;
		padding: 0;
		font-size: 0.95rem;
	}
	ul.plain li {
		padding-left: 1.3em;
		position: relative;
		margin-bottom: 0.6em;
		color: var(--muted);
	}
	ul.plain li::before {
		content: "·";
		position: absolute;
		left: 0.3em;
	}
	.alive-edge ul.plain li::before {
		content: "✓";
		color: var(--alive);
		left: 0;
	}
	.steps {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
		margin: 1.4em 0 0;
		padding: 0;
	}
	.steps li {
		border-top: 2px solid var(--border);
		padding-top: 1em;
	}
	.steps .n {
		font-family: var(--mono);
		color: var(--alive);
		font-size: 0.8rem;
	}
	.steps h3 {
		font-size: 1.05rem;
		margin: 0.2em 0 0.4em;
	}
	.steps p {
		color: var(--muted);
		font-size: 0.93rem;
		margin: 0;
	}
	@media (max-width: 860px) {
		.hero,
		.two,
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
