---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AlertDemo from "../components/AlertDemo.astro";
import {
	CONTACT_EMAIL,
	EXAMPLE_REPO,
	EXAMPLE_URL,
	GITHUB_URL,
	SERVICES,
	SIGNUP_CURL,
	SITE_DESCRIPTION,
	SITE_TITLE,
	X_HANDLE,
	X_URL,
} from "../consts";

const highlights = [
	{ title: "No client", text: "HTTP and an Authorization header. No SDK to pin, no agent to run alongside your job." },
	{ title: "One key", text: "The same key works on every host. POST /v1/signup returns it; there is no console to log into." },
	{ title: "Nothing of mine to fail", text: "Cloudflare Workers and D1. No VM in the path, so there is no VM of mine to fall over." },
	{ title: "Free", text: "No card. It costs me about five dollars a month whether anyone uses it or not." },
];

const cron = `# at the end of the job you already have
0 3 * * * backup.sh && curl -fsS -X POST \\
  -H "Authorization: Bearer $NANO_API_KEY" \\
  https://pulse.nano-api.com/v1/ping/nightly-backup`;

const alertCurl = `curl -X PATCH $PULSE/v1/monitors/nightly-backup \\
  -d '{"alert_webhook_url": "https://hooks.slack.com/services/..."}'`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — small HTTP services, free to use`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">nano-api</p>
				<h1>Things I kept building from scratch</h1>
				<p class="tagline">
					A heartbeat monitor that posts to Slack when a cron job goes quiet. Scheduled HTTP calls
					that respect a timezone. A lock with a lease. A JSON document I can change without a
					deploy. A counter. I have written every one of these at least twice, in a hurry, and got
					the concurrency wrong at least once. These versions have tests.
				</p>
				<p class="cta">
					<a class="button" href="/howto/">Start in curl</a>
					<a class="button secondary" href={EXAMPLE_URL} rel="noopener" target="_blank">See it running</a>
					<a class="button secondary" href={GITHUB_URL} rel="noopener" target="_blank">Source</a>
				</p>
				<pre class="signup"><code>{SIGNUP_CURL}</code></pre>
				<p class="under muted">The key is in the response body. That is the whole signup.</p>
			</section>

			<section class="highlights">
				{
					highlights.map((item) => (
						<div class="highlight">
							<h2>{item.title}</h2>
							<p>{item.text}</p>
						</div>
					))
				}
			</section>

			<section class="band">
				<h2 class="centered">What is here now</h2>
				<p class="centered lead">
					Each has its own page: the guarantee, the cases where it does not help, and the curl.
				</p>
				<div class="services">
					{
						SERVICES.map((service) => (
							<a class="card service" href={service.href}>
								<code class="host">{service.host}</code>
								<h3>{service.name}</h3>
								<p class="summary">{service.summary}</p>
								<span class="more">Read more &rarr;</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="band example">
				<p class="eyebrow centered">Pulse, as the short example</p>
				<h2 class="centered">One line at the end of a job you already have</h2>
				<p class="centered lead">
					The <code>&&</code> does the work. A failed script never reaches the ping, the deadline
					passes, and the sweep notices the silence within a minute.
				</p>
				<pre><code>{cron}</code></pre>

				<div class="pair">
					<div>
						<h3>One message down, one message back up</h3>
						<p>
							Any HTTPS webhook. The body is Slack-shaped, so a Slack hook needs no mapping. It
							fires on transitions, not per missed deadline, so three quiet hours is one message.
						</p>
						<pre><code>{alertCurl}</code></pre>
					</div>
					<AlertDemo />
				</div>

				<p class="centered outro">
					The others are the same shape: one host, one key, one job.
					<a href="/pulse/">Pulse in full</a>, or
					<a href="/howto/">the how-to, which runs through all of them in curl</a>.
				</p>
			</section>

			<section class="band">
				<h2 class="centered">Something using all of them at once</h2>
				<p class="centered lead">
					<a href={EXAMPLE_URL} rel="noopener" target="_blank">A stock ticker on a small Linode</a>
					runs on the whole set: Relay calls it every 15 minutes, Lock keeps that to one copy,
					Config holds the tickers and a kill switch, Count tallies renders and runs, Pulse watches
					for it going quiet. The panel at the bottom of the page reports what each one did last
					cycle.
				</p>
				<p class="centered">
					<a href={EXAMPLE_REPO} rel="noopener" target="_blank">545 lines, no dependencies</a>
					The shell pattern for taking a lock without a race is in there, and that is the part
					worth copying.
				</p>
			</section>

			<section class="closing card">
				<h2>Take a key and use it</h2>
				<p>
					One person, evenings and weekends, in Norway. It is free because charging would commit me
					to a response time I cannot hold down alongside a day job. Bugs and questions reach the
					person who wrote the code:
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or
					<a href={X_URL} rel="noopener" target="_blank">{X_HANDLE}</a>.
				</p>
				<p class="cta centered">
					<a class="button" href="/howto/">How to, in curl</a>
					<a class="button secondary" href="/about/">What this is</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Centred hero, feature row, then the detail — plenty of air between. */
	.hero {
		text-align: center;
		max-width: 44rem;
		margin: 0 auto;
		padding: 3.5em 0 1em;
	}
	.hero h1 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		line-height: 1.15;
		margin-bottom: 0.8em;
	}
	.tagline {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 36em;
		margin: 0 auto 1.8em;
	}
	.tagline strong {
		color: var(--text);
	}
	.cta {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		justify-content: center;
		margin: 0 0 2em;
	}
	.signup {
		font-size: 0.76rem;
		text-align: left;
		margin: 0;
	}
	.under {
		font-size: 0.85rem;
		margin: 0.7em 0 0;
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: 1.2em;
		margin: 3.5em 0 0;
	}
	.highlight {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.3em;
		min-width: 0;
	}
	.highlight h2 {
		font-size: 1rem;
		margin: 0 0 0.45em;
	}
	.highlight p {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
	}

	.band {
		padding: 4em 0 0;
	}
	.centered {
		text-align: center;
	}
	.lead {
		max-width: 40em;
		margin: 0.8em auto 0;
		color: var(--muted);
	}
	.band pre {
		margin-top: 1.6em;
	}

	.services {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.2em;
		margin-top: 1.8em;
	}
	.service {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.service:hover {
		border-color: var(--alive-dim);
		transform: translateY(-2px);
	}
	.service h3 {
		margin: 0.6em 0 0.35em;
		font-size: 1.1rem;
	}
	.host {
		align-self: flex-start;
		font-size: 0.75rem;
	}
	.summary {
		color: var(--muted);
		margin: 0.9em 0 1.1em;
		font-size: 0.93rem;
	}
	.more {
		margin-top: auto;
		color: var(--link);
		font-size: 0.92rem;
	}

	/* The worked example is the one place the page gets concrete, so it is
	   fenced off with a rule rather than left to float between the bands. */
	.example {
		border-top: 1px solid var(--border);
		margin-top: 4em;
	}
	.example .eyebrow {
		margin-bottom: 0.6em;
	}
	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.2em;
		align-items: center;
		margin-top: 3em;
	}
	.pair h3 {
		font-size: 1.35rem;
	}
	.pair p {
		color: var(--muted);
	}
	.pair pre {
		font-size: 0.72rem;
		margin-top: 1.2em;
	}
	.outro {
		max-width: 44em;
		margin: 2.6em auto 0;
		color: var(--muted);
	}

	.closing {
		margin-top: 4em;
		text-align: center;
	}
	.closing p {
		color: var(--muted);
		max-width: 36em;
		margin: 0.6em auto 0;
	}
	.closing .cta {
		margin: 1.6em 0 0;
	}

	@media (max-width: 860px) {
		.pair {
			grid-template-columns: 1fr;
		}
	}
</style>
