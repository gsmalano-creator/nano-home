---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AlertDemo from "../components/AlertDemo.astro";
import {
	CONTACT_EMAIL,
	EXAMPLE_REPO,
	EXAMPLE_URL,
	GITHUB_URL,
	SERVICES,
	SIGNUP_CURL,
	SITE_DESCRIPTION,
	SITE_TITLE,
	X_HANDLE,
	X_URL,
} from "../consts";

const highlights = [
	{ emoji: "🤏", title: "Small", text: "One endpoint per job. Nothing to install, nothing to configure, nothing to learn." },
	{ emoji: "🔑", title: "One key", text: "The same key opens all five. Signup is a single curl and the key is in the reply." },
	{ emoji: "🌍", title: "Not your server", text: "Cloudflare Workers and a serverless database. Nothing for you to keep alive." },
	{ emoji: "🆓", title: "Free", text: "No card, no trial clock. It costs me a few dollars a month either way." },
];

const cron = `# at the end of the job you already have
0 3 * * * backup.sh && curl -fsS -X POST \\
  -H "Authorization: Bearer $NANO_API_KEY" \\
  https://pulse.nano-api.com/v1/ping/nightly-backup`;

const alertCurl = `curl -X PATCH $PULSE/v1/monitors/nightly-backup \\
  -d '{"alert_webhook_url": "https://hooks.slack.com/services/..."}'`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — five small things, free to use`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">nano-api</p>
				<h1>Five things I kept<br />building from scratch.</h1>
				<p class="tagline">
					Knowing a job ran. Running it on time. Stopping two copies colliding. Holding a value you
					can change without a deploy. Counting something. I have written all five more times than
					I can remember, badly and in a hurry, on project after project. So I wrote them once
					more, properly, and put them behind an HTTP endpoint. <strong>Help yourself.</strong>
				</p>
				<p class="cta">
					<a class="button" href="/howto/">Start in curl</a>
					<a class="button secondary" href={EXAMPLE_URL} rel="noopener" target="_blank">See it running</a>
					<a class="button secondary" href={GITHUB_URL} rel="noopener" target="_blank">Source</a>
				</p>
				<pre class="signup"><code>{SIGNUP_CURL}</code></pre>
				<p class="under muted">That is the signup. The key comes back in the response.</p>
			</section>

			<section class="highlights">
				{
					highlights.map((item) => (
						<div class="highlight">
							<p class="ico" aria-hidden="true">{item.emoji}</p>
							<h2>{item.title}</h2>
							<p>{item.text}</p>
						</div>
					))
				}
			</section>

			<section class="band">
				<h2 class="centered">The five</h2>
				<p class="centered lead">
					Each one has its own page with the whole story: what it guarantees, where it does not
					help, and the curl to try it.
				</p>
				<div class="services">
					{
						SERVICES.map((service) => (
							<a class="card service" href={service.href}>
								<p class="ico" aria-hidden="true">{service.emoji}</p>
								<h3>{service.name}</h3>
								<code class="host">{service.host}</code>
								<p class="summary">{service.summary}</p>
								<span class="more">Read more &rarr;</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="band example">
				<p class="eyebrow centered">Take one of them: Pulse</p>
				<h2 class="centered">What using any of these actually looks like</h2>
				<p class="centered lead">
					Pulse is the heartbeat one, and it is the shortest to show. You add a line to a cron job
					you already have. The <code>&&</code> is the trick: if the job fails, the ping never
					happens, and the silence is the thing that gets noticed.
				</p>
				<pre><code>{cron}</code></pre>

				<div class="pair">
					<div>
						<h3>Then you hear about it — once</h3>
						<p>
							Point it at a Slack webhook and you are done. It fires on changes only: once when
							the pings stop, once when they come back. Nobody needs the same bad news every
							minute.
						</p>
						<pre><code>{alertCurl}</code></pre>
					</div>
					<AlertDemo />
				</div>

				<p class="centered outro">
					The other four work exactly the same way — one endpoint, one key, one job each.
					<a href="/pulse/">The rest of Pulse is on its own page</a>, and
					<a href="/howto/">the how-to runs through all five end to end</a>.
				</p>
			</section>

			<section class="band">
				<h2 class="centered">One thing running on all five at once</h2>
				<p class="centered lead">
					<a href={EXAMPLE_URL} rel="noopener" target="_blank">A stock ticker on a small Linode</a>
					uses the lot: Relay calls it, Lock keeps the run to one copy, Config decides which
					tickers, Count tallies the runs, Pulse notices if it stops. The panel at the bottom of
					that page shows what each service did last cycle — the product watching itself, which is
					either elegant or a bit smug.
				</p>
				<p class="centered">
					<a href={EXAMPLE_REPO} rel="noopener" target="_blank">The source is 545 lines, no dependencies</a>
					— including the shell pattern for taking a lock and the ping that turns silence into an
					alert.
				</p>
			</section>

			<section class="closing card">
				<h2>Take a key and use it</h2>
				<p>
					Written by one person, evenings and weekends, in Norway. It is free because charging
					would mean promising a response time I cannot promise while I have a day job. If
					something is broken or missing, you reach the person who wrote it:
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or
					<a href={X_URL} rel="noopener" target="_blank">{X_HANDLE}</a>.
				</p>
				<p class="cta centered">
					<a class="button" href="/howto/">How to, in curl</a>
					<a class="button secondary" href="/about/">What this is</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Centred hero, feature row, then the detail — plenty of air between. */
	.hero {
		text-align: center;
		max-width: 44rem;
		margin: 0 auto;
		padding: 3.5em 0 1em;
	}
	.hero h1 {
		font-size: clamp(2.4rem, 7vw, 4rem);
		line-height: 1.05;
		margin-bottom: 0.7em;
	}
	.tagline {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 36em;
		margin: 0 auto 1.8em;
	}
	.tagline strong {
		color: var(--text);
	}
	.cta {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		justify-content: center;
		margin: 0 0 2em;
	}
	.signup {
		font-size: 0.76rem;
		text-align: left;
		margin: 0;
	}
	.under {
		font-size: 0.85rem;
		margin: 0.7em 0 0;
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: 1.2em;
		margin: 3.5em 0 0;
	}
	.highlight {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.3em;
		min-width: 0;
	}
	.highlight h2 {
		font-size: 1.05rem;
		margin: 0.4em 0 0.35em;
	}
	.highlight p {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.ico {
		font-size: 1.5rem;
		margin: 0;
		line-height: 1;
	}

	.band {
		padding: 4em 0 0;
	}
	.centered {
		text-align: center;
	}
	.lead {
		max-width: 40em;
		margin: 0.8em auto 0;
		color: var(--muted);
	}
	.band pre {
		margin-top: 1.6em;
	}

	.services {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.2em;
		margin-top: 1.8em;
	}
	.service {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.service:hover {
		border-color: var(--alive-dim);
		transform: translateY(-2px);
	}
	.service h3 {
		margin: 0.5em 0 0.35em;
		font-size: 1.25rem;
	}
	.host {
		align-self: flex-start;
		font-size: 0.78rem;
	}
	.summary {
		color: var(--muted);
		margin: 0.9em 0 1.1em;
		font-size: 0.93rem;
	}
	.more {
		margin-top: auto;
		color: var(--link);
		font-size: 0.92rem;
	}

	/* The worked example is the one place the page gets concrete, so it is
	   fenced off with a rule rather than left to float between the bands. */
	.example {
		border-top: 1px solid var(--border);
		margin-top: 4em;
	}
	.example .eyebrow {
		margin-bottom: 0.6em;
	}
	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.2em;
		align-items: center;
		margin-top: 3em;
	}
	.pair h3 {
		font-size: 1.35rem;
	}
	.pair p {
		color: var(--muted);
	}
	.pair pre {
		font-size: 0.72rem;
		margin-top: 1.2em;
	}
	.outro {
		max-width: 44em;
		margin: 2.6em auto 0;
		color: var(--muted);
	}

	.closing {
		margin-top: 4em;
		text-align: center;
	}
	.closing p {
		color: var(--muted);
		max-width: 36em;
		margin: 0.6em auto 0;
	}
	.closing .cta {
		margin: 1.6em 0 0;
	}

	@media (max-width: 860px) {
		.pair {
			grid-template-columns: 1fr;
		}
	}
</style>
