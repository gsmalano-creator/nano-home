---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AlertDemo from "../components/AlertDemo.astro";
import { CONTACT_EMAIL, SERVICES, SITE_DESCRIPTION, SITE_TITLE, WHAT_YOU_GET, X_HANDLE, X_URL } from "../consts";

const alertCurl = `curl -X PATCH $PULSE/v1/monitors/nightly-backup \\
  -d '{"alert_webhook_url": "https://hooks.slack.com/services/..."}'`;

const snippets: Record<string, string> = {
	NanoPulse: `backup.sh && curl -fsS -X POST \\
  $PULSE/v1/ping/nightly-backup`,
	NanoRelay: `curl -X POST $RELAY/v1/schedules -d '{
  "cron": "0 3 * * *", "timezone": "Europe/Oslo",
  "url": "https://api.example.com/jobs/report" }'`,
	NanoLock: `curl -X POST "$LOCK/v1/locks/import?ttl=60"
# 201 -> you have it   409 -> someone else does`,
	NanoConfig: `curl -X PATCH $CONFIG/v1/configs/checkout \\
  -d '{"maintenance": true}'   # no deploy, no restart`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — small APIs for the jobs nobody is watching`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">nano-api</p>
				<h1>Small, sharp APIs for the jobs <span class="dim">nobody is watching.</span></h1>
				<p class="lede">
					One API key. No dashboard. Each service does one thing you would otherwise build and
					maintain yourself.
				</p>
				<p class="cta">
					<a class="button" href={`mailto:${CONTACT_EMAIL}?subject=nano-api%20key`}>Get a free API key</a>
					<a class="button secondary" href="/howto/">How to, in curl</a>
				</p>
				<p class="free">
					<span class="tag live">Free</span>
					Everything is free while the service is young. <a href="/pricing/">What that means.</a>
				</p>
			</section>

			<section class="services">
				{
					SERVICES.map((service) => (
						<a class="card service" href={service.href}>
							<p class:list={["tag", { live: service.status === "live" }]}>
								{service.status === "live" ? "Live" : "Planned"}
							</p>
							<h2>{service.name}</h2>
							<code class="host">{service.host}</code>
							<p class="summary">{service.summary}</p>
							{snippets[service.name] && <pre><code>{snippets[service.name]}</code></pre>}
							<span class="more">Read more &rarr;</span>
						</a>
					))
				}
			</section>

			<section class="band alerts">
				<div>
					<h2>You find out in Slack</h2>
					<p>
						One webhook, no app to install. Alerts fire on state changes only — once when
						something breaks, once when it recovers. Never one per failed run.
					</p>
					<pre><code>{alertCurl}</code></pre>
				</div>
				<AlertDemo />
			</section>

			<section class="band">
				<h2>In every plan</h2>
				<ul class="shared">
					{WHAT_YOU_GET.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="band">
				<h2>They cover each other</h2>
				<p>
					Relay runs the job. Lock keeps it to one copy. Pulse notices if it stops running at all —
					including when Relay is the thing that stopped.
				</p>
				<p class="cta">
					<a class="button" href="/pulse/">NanoPulse</a>
					<a class="button secondary" href="/relay/">NanoRelay</a>
					<a class="button secondary" href="/lock/">NanoLock</a>
				</p>
			</section>

			<section class="band">
				<h2>Who runs it</h2>
				<p>
					One person, alongside a day job — which is the reason for the small surface and the honest
					limits. <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>,
					<a href={X_URL} rel="noopener" target="_blank">{X_HANDLE}</a> on X, or
					<a href="/about/">more about that</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 3em 0 1em;
		max-width: 38em;
	}
	.dim {
		color: var(--muted);
	}
	.lede {
		font-size: 1.12rem;
		color: var(--muted);
	}
	.cta {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		margin: 1.5em 0 1.2em;
	}
	.free {
		display: flex;
		align-items: baseline;
		gap: 0.7em;
		flex-wrap: wrap;
		font-size: 0.9rem;
		color: var(--muted);
		padding: 0.8em 1em;
		border: 1px solid var(--alive-dim);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.services {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.2em;
		margin-top: 2.5em;
	}
	.service {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.service:hover {
		border-color: var(--alive-dim);
		transform: translateY(-2px);
	}
	.service .tag {
		align-self: flex-start;
	}
	.service h2 {
		margin: 0.6em 0 0.35em;
		font-size: 1.5rem;
	}
	.host {
		align-self: flex-start;
	}
	.summary {
		color: var(--muted);
		margin: 0.9em 0 1em;
		font-size: 0.95rem;
	}
	.service pre {
		font-size: 0.75rem;
		margin: 0 0 1.1em;
	}
	.more {
		margin-top: auto;
		color: var(--link);
		font-size: 0.92rem;
	}

	.band {
		padding: 3em 0 0;
	}
	.alerts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2em;
		align-items: center;
	}
	.alerts pre {
		font-size: 0.72rem;
	}
	@media (max-width: 860px) {
		.alerts {
			grid-template-columns: 1fr;
		}
	}
	.band > p {
		max-width: 46em;
		color: var(--muted);
	}
	ul.shared {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6em 1.5em;
		margin: 1.2em 0 1.6em;
		padding: 0;
	}
	ul.shared li {
		position: relative;
		padding-left: 1.6em;
		color: var(--muted);
	}
	ul.shared li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--alive);
	}
	@media (max-width: 720px) {
		ul.shared {
			grid-template-columns: 1fr;
		}
	}
</style>
