---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CONFIG_BASE, CONTACT_EMAIL, COUNT_BASE, LOCK_BASE, SERVICES, SIGNUP_CURL, SITE_TITLE, X_HANDLE, X_URL } from "../consts";

const relay = SERVICES.find((s) => s.name === "NanoRelay");
const relayIsLive = relay?.status === "live";

const setup = `export KEY=np_live_...              # the key you were sent
export PULSE=https://pulse.nano-api.com
export RELAY=https://relay.nano-api.com
export LOCK=https://lock.nano-api.com
export CONFIG=https://configmaps.nano-api.com
export COUNT=https://count.nano-api.com
auth=(-H "Authorization: Bearer $KEY" -H 'content-type: application/json')`;

const firstPing = `curl -X POST "$PULSE/v1/ping/nightly-backup?interval=86400&grace=3600" "\${auth[@]}"`;

const crontab = `0 3 * * * /usr/local/bin/backup.sh && curl -fsS -X POST \\
  -H "Authorization: Bearer $KEY" \\
  https://pulse.nano-api.com/v1/ping/nightly-backup`;

const pingPayload = `curl -X POST "$PULSE/v1/ping/nightly-backup" "\${auth[@]}" \\
  -d '{"rows_exported": 12043, "duration_s": 94}'`;

const alerts = `curl -X PATCH "$PULSE/v1/monitors/nightly-backup" "\${auth[@]}" \\
  -d '{"alert_webhook_url": "https://hooks.slack.com/services/..."}'`;

const proveIt = `# 1. a monitor with the shortest allowed window
curl -X POST "$PULSE/v1/monitors" "\${auth[@]}" \\
  -d '{"slug":"alert-test","expected_interval_seconds":30,"grace_period_seconds":0,
       "alert_webhook_url":"https://hooks.slack.com/services/..."}'

# 2. one ping, so it has something to miss
curl -X POST "$PULSE/v1/ping/alert-test" "\${auth[@]}"

# 3. let the window pass, then run the sweep yourself
sleep 35
curl -X POST "$PULSE/v1/checks/run" "\${auth[@]}"      # -> 🔴 in Slack

# 4. ping again to recover, then clean up
curl -X POST "$PULSE/v1/ping/alert-test" "\${auth[@]}"  # -> 🟢 in Slack
curl -X DELETE "$PULSE/v1/monitors/alert-test" "\${auth[@]}"`;

const inspect = `curl -s "$PULSE/v1/monitors/nightly-backup" "\${auth[@]}" | jq`;

const reportFailure = `curl -X POST "$PULSE/v1/ping/nightly-backup?status=fail" "\${auth[@]}"`;

const pauseMonitor = `curl -X PATCH "$PULSE/v1/monitors/nightly-backup" "\${auth[@]}" -d '{"paused": true}'`;

const createSchedule = `curl -X POST "$RELAY/v1/schedules" "\${auth[@]}" -d '{
  "slug": "nightly-report",
  "cron": "0 3 * * *",
  "timezone": "Europe/Oslo",
  "url": "https://api.example.com/jobs/nightly-report",
  "body": {"source": "relay"},
  "max_attempts": 3,
  "timeout_seconds": 30,
  "alert_webhook_url": "https://hooks.slack.com/services/..."
}'`;

const runNow = `curl -X POST "$RELAY/v1/schedules/nightly-report/run" "\${auth[@]}" | jq .run`;

const runNowOutput = `{
  "outcome": "ok",
  "status_code": 200,
  "duration_ms": 412,
  "response_excerpt": "{\\"ok\\":true}",
  "error": null,
  "attempts": 1,
  "run_id": "752cb057-e1f9-4512-812d-8100ea1cee8d"
}`;

const scheduleHistory = `curl -s "$RELAY/v1/schedules/nightly-report" "\${auth[@]}" | jq .recent_runs`;

const pauseSchedule = `curl -X PATCH "$RELAY/v1/schedules/nightly-report" "\${auth[@]}" -d '{"paused": true}'
curl -X PATCH "$RELAY/v1/schedules/nightly-report" "\${auth[@]}" -d '{"cron": "*/15 * * * *"}'
curl -X DELETE "$RELAY/v1/schedules/nightly-report" "\${auth[@]}"`;

const both = `# 1. Relay calls your endpoint every hour.
curl -X POST "$RELAY/v1/schedules" "\${auth[@]}" -d '{
  "slug": "hourly-sync",
  "cron": "0 * * * *",
  "url": "https://api.example.com/jobs/sync"
}'

# 2. Inside that endpoint: take the lock, or return early.
#    3. And ping Pulse at the end, so silence is still an alert
#       even if Relay itself stops calling.
curl -X POST "$PULSE/v1/ping/hourly-sync?interval=3600&grace=600" "\${auth[@]}"`;

const lockAcquire = `RESPONSE=$(curl -sf -X POST "$LOCK/v1/locks/nightly-import?ttl=60&owner=$HOSTNAME" \\
  "\${auth[@]}") || { echo "someone else has it"; exit 0; }

TOKEN=$(jq -r .token <<< "$RESPONSE")
trap 'curl -sf -X DELETE "$LOCK/v1/locks/nightly-import?token=$TOKEN" "\${auth[@]}" > /dev/null' EXIT

./import.sh`;

const lockRenew = `curl -X POST "$LOCK/v1/locks/nightly-import/renew?token=$TOKEN&ttl=60" "\${auth[@]}"`;

const lockStatus = `curl -s "$LOCK/v1/locks" "\${auth[@]}" | jq
# [{ "name": "nightly-import", "held": true, "owner": "pod-a", "fence": 8, "expires_at": "..." }]`;

const configWrite = `curl -X PUT "$CONFIG/v1/configs/checkout" "\${auth[@]}" \\
  -d '{"maintenance": false, "max_items": 50}'`;

const configFlip = `curl -X PATCH "$CONFIG/v1/configs/checkout?note=incident-4711" "\${auth[@]}" \\
  -H 'if-match: "7"' -d '{"maintenance": true}'
# 412 if someone wrote first, with both version numbers in the body`;

const configRead = `curl -s "$CONFIG/v1/configs/checkout" "\${auth[@]}" -H 'if-none-match: "8"' -o /dev/null -w '%{http_code}\\n'
# 304 while nothing changes — poll as often as you like

curl -s "$CONFIG/v1/configs/checkout/keys/maintenance" "\${auth[@]}"`;

const configRollback = `curl -s "$CONFIG/v1/configs/checkout/revisions" "\${auth[@]}" | jq '.revisions[] | {version, note}'
curl -X POST "$CONFIG/v1/configs/checkout/rollback" "\${auth[@]}" -d '{"to": 7}'`;

const countUp = `curl -X POST "$COUNT/v1/counters/downloads?label=downloads" "\${auth[@]}"
# {"counter":{"value":1,"badge_url":"$COUNT/b/pub_…svg", …}}

curl -X POST "$COUNT/v1/counters/downloads?by=5" "\${auth[@]}"    # 6
curl -X PUT  "$COUNT/v1/counters/downloads?value=12300" "\${auth[@]}"`;

const countBadge = `![downloads]($COUNT/b/pub_….svg)

# or read the number from a browser — CORS is open on this one
curl -s "$COUNT/b/pub_….json"`;

const keys = `curl -s "$PULSE/v1/keys" "\${auth[@]}" | jq            # prefixes, last used, active
curl -X POST "$PULSE/v1/keys" "\${auth[@]}" -d '{"name":"CI"}'  # new key, shown once
curl -X DELETE "$PULSE/v1/keys/key_abc123" \\
  -H "Authorization: Bearer $NEW_KEY"                          # revoke the old one`;

const usage = `curl -s "$PULSE/v1/whoami" "\${auth[@]}" | jq .usage
# { "monitors": 3, "schedules": 2, "used": 5, "limit": 5, "remaining": 0 }`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`How to — ${SITE_TITLE}`}
			description="Copy-paste walkthroughs for every nano-api service: heartbeats, scheduled calls, locks, config and counters."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page">
				<p class="eyebrow">How to</p>
				<h1>Every service, end to end.</h1>
				<p class="lede">
					Copy-paste, all of it. The service is nothing but a set of HTTP endpoints, so the
					examples use <code>curl</code> because it reads well on a page — reach for whatever
					client you already like.
				</p>

				<nav class="toc">
					<a href="#setup">Setup</a>
					<a href="#pulse">Pulse: get told when a job stops</a>
					<a href="#prove">Prove the alert works</a>
					<a href="#relay">Relay: run the job for you</a>
					<a href="#lock">Lock: run it only once</a>
					<a href="#config">Config: change it without a deploy</a>
					<a href="#count">Count: a number for the README</a>
					<a href="#together">All of them together</a>
					<a href="#keys">Keys and quota</a>
				</nav>

				<h2 id="setup">Setup</h2>
				<p>Take a key. No form, no verification mail, nobody to ask:</p>
				<pre><code>{SIGNUP_CURL}</code></pre>
				<p class="muted">
					The key is in the response and nowhere else — only its hash is stored. Three signups per
					address per hour, in case you were wondering where the limit is. Then, in the shell you
					are about to work in:
				</p>
				<pre><code>{setup}</code></pre>
				<p class="muted">
					Every hostname serves the same API, so these variables are interchangeable. They exist
					only so the URLs read correctly in your own scripts.
				</p>

				<h2 id="pulse">Pulse: get told when a job stops</h2>
				<p>
					The first ping creates the monitor. <code>interval</code> is how often you expect it and
					<code>grace</code> is how late it may be, in seconds, read only at creation.
				</p>
				<pre><code>{firstPing}</code></pre>

				<p>In real life that line lives at the end of the job:</p>
				<pre><code>{crontab}</code></pre>
				<p class="muted">
					The <code>&amp;&amp;</code> is the trick: a failed script never pings, the deadline
					passes, you hear about it. Failure is the default.
				</p>

				<p>A ping can carry up to 2 KB of context, which shows up in the monitor's history:</p>
				<pre><code>{pingPayload}</code></pre>

				<p>Send alerts somewhere. Any HTTPS webhook works; Slack needs no configuration:</p>
				<pre><code>{alerts}</code></pre>

				<p>Look at what happened — status, last ping, and the most recent pings and events:</p>
				<pre><code>{inspect}</code></pre>

				<p>
					If the job knows it failed, it can say so instead of waiting for the deadline. This marks
					the monitor down immediately:
				</p>
				<pre><code>{reportFailure}</code></pre>

				<p>Going on holiday with the job disabled? Pause it so it does not page you:</p>
				<pre><code>{pauseMonitor}</code></pre>

				<h2 id="prove">Prove the alert works</h2>
				<p>
					Do this once, on setup day — not during a real outage. <code>/v1/checks/run</code> is the
					same sweep the cron runs, triggered by hand:
				</p>
				<pre><code>{proveIt}</code></pre>
				<p class="muted">
					<code>notified: true</code> in <code>recent_events</code> means the receiver answered 2xx.
					<code>false</code> means it never arrived.
				</p>

				<h2 id="relay">Relay: run the job for you</h2>
				{
					!relayIsLive && (
						<p class="notice">
							<span class="tag">Planned</span>
							Relay is built but not yet serving traffic. The calls below are exactly what it
							exposes — they will work the day it goes live.
						</p>
					)
				}
				<p>
					A cron expression, a timezone and a request. The timezone is the point:
					<code>0 3 * * *</code> in <code>Europe/Oslo</code> stays at 03:00 across daylight saving,
					where a UTC-only cron drifts.
				</p>
				<pre><code>{createSchedule}</code></pre>

				<p>Run it immediately to check the target is reachable. This does not move the schedule:</p>
				<pre><code>{runNow}</code></pre>
				<pre><code>{runNowOutput}</code></pre>

				<p>Every run is kept — outcome, status code, duration, how many attempts it took:</p>
				<pre><code>{scheduleHistory}</code></pre>

				<p>Change it, pause it, remove it:</p>
				<pre><code>{pauseSchedule}</code></pre>

				<p class="muted">
					Up to 3 attempts with 2s and 6s backoff. Alerts on transitions only. Delivery is
					at-least-once and every request carries <code>X-NanoRelay-Run-Id</code>, so make the
					endpoint idempotent.
				</p>

				<h2 id="lock">Lock: run it only once</h2>
				<p>
					201 with a token, or 409 if somebody else holds it. <code>curl -sf</code> exits non-zero
					on 409 so the second instance stops, and <code>trap</code> releases however the script
					ends. Capture the response before parsing: piped into <code>jq</code>, the
					<code>||</code> would test jq's exit status, and a refused lock would become an empty
					token and a job that runs anyway.
				</p>
				<pre><code>{lockAcquire}</code></pre>

				<p>Longer than the lease? Renew while you work instead of asking for a huge TTL:</p>
				<pre><code>{lockRenew}</code></pre>

				<p>See who holds what, without anyone's token being revealed:</p>
				<pre><code>{lockStatus}</code></pre>
				<p class="muted">
					Only the holder can release or renew; a wrong token gets 409. <code>fence</code> only ever
					increases — hand it downstream to reject a stalled holder that wakes up late.
				</p>

				<h2 id="config">Config: change it without a deploy</h2>
				<p>A config is a small JSON document. Write the whole thing, or merge keys into it:</p>
				<pre><code>{configWrite}</code></pre>

				<p>
					Flip a switch mid-incident. <code>If-Match</code> makes it conditional, so two people
					reacting at once cannot silently overwrite each other:
				</p>
				<pre><code>{configFlip}</code></pre>

				<p>Reading is cheap, and a single key is one call:</p>
				<pre><code>{configRead}</code></pre>

				<p>Every write is kept, with the note you passed — and rollback writes forward:</p>
				<pre><code>{configRollback}</code></pre>
				<p class="muted">
					Restoring v7 becomes v9, never v7 again. A client caching by version number can then
					trust that one number means one thing forever.
				</p>

				<h2 id="count">Count: a number for the README</h2>
				<p>Counters are created on first use, and increments are atomic:</p>
				<pre><code>{countUp}</code></pre>

				<p>The badge needs no key, so it works where a README image is fetched anonymously:</p>
				<pre><code>{countBadge}</code></pre>
				<p class="muted">
					Reads never increment — a caching proxy in front of a hit counter would either freeze the
					number or inflate it. <code>?label=</code> and <code>?color=</code> restyle the badge per
					request.
				</p>

				<h2 id="together">All of them together</h2>
				<p>Relay runs it, Lock runs it once, Pulse notices if it stops.</p>
				<pre><code>{both}</code></pre>

				<h2 id="keys">Keys and quota</h2>
				<p>The key is the account. No login, so key management is an API too:</p>
				<pre><code>{keys}</code></pre>
				<p class="muted">
					Revoking the key you are using is refused, so nobody locks themselves out. New one first,
					then revoke the old with it.
				</p>

				<p>Monitors and schedules share one quota. Check where you stand:</p>
				<pre><code>{usage}</code></pre>
				<p class="muted">
					At the limit, <em>new</em> monitors and schedules get <code>quota_exceeded</code>. Pings
					and runs for existing ones never do.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		max-width: 46em;
		padding: 2em 0 0;
	}
	.lede {
		color: var(--muted);
		font-size: 1.05rem;
	}
	.toc {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 1.2em;
		margin: 2em 0 1em;
		padding: 1em 1.2em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		font-size: 0.92rem;
	}
	h2 {
		margin-top: 2.4em;
		font-size: 1.5rem;
		scroll-margin-top: 4em;
	}
	.page p {
		color: var(--muted);
	}
	pre {
		margin: 1em 0 1.6em;
	}
	.notice {
		display: flex;
		align-items: baseline;
		gap: 0.8em;
		padding: 0.9em 1.1em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		font-size: 0.93rem;
	}
</style>
