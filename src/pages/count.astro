---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CountDemo from "../components/CountDemo.astro";
import { COUNT_BASE, SITE_TITLE } from "../consts";

const increment = `curl -X POST "${COUNT_BASE}/v1/counters/downloads?label=downloads" \\
  -H "Authorization: Bearer $NANO_API_KEY"
# {"counter":{"value":1,"badge_url":"${COUNT_BASE}/b/pub_…svg", …}}`;

const badge = `![downloads](${COUNT_BASE}/b/pub_….svg)`;

const read = `curl -s ${COUNT_BASE}/b/pub_….json
# {"name":"downloads","value":12300}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`NanoCount — ${SITE_TITLE}`}
			description="A named counter that cannot lose an increment, with an SVG badge for your README. Free, one curl to start."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<p class="eyebrow">nano-api / count</p>
					<h1>One number.<br /><span class="dim">Not worth a database.</span></h1>
					<p class="lede">
						Count anything — downloads, exports, runs — then embed the badge or read the value.
						No table to migrate, no analytics script, and never a lost increment.
					</p>
					<p class="cta">
						<a class="button" href="/howto/#setup">Take a key</a>
						<a class="button secondary" href="/howto/#count">Curl walkthrough</a>
					</p>
					<p class="fineprint muted">
						Free. Signup is one <code>curl</code> and the key is in the reply — no form, no card,
						nobody to ask.
					</p>
				</div>
				<CountDemo />
			</section>

			<section class="band">
				<h2>Increment from anywhere</h2>
				<pre><code>{increment}</code></pre>
				<p class="muted small">
					<code>?by=5</code> to add more, <code>PUT</code> to set an exact value. The counter is
					created on first use.
				</p>
			</section>

			<section class="band">
				<h2>Then paste one line</h2>
				<pre><code>{badge}</code></pre>
				<p class="muted small">
					<code>?label=</code> and <code>?color=</code> override it per request. Or read the raw
					number from a browser — the JSON endpoint is CORS-open:
				</p>
				<pre><code>{read}</code></pre>
			</section>

			<section class="band">
				<h2>Three ways I got this wrong by hand</h2>
				<ol class="steps">
					<li>
						<span class="n">1</span>
						<h3>Two writers, one lost count</h3>
						<p>
							The obvious version reads the number, adds one, writes it back. Two callers who read
							the same moment write the same value, and an increment vanishes. Here adding and
							returning is one statement, so there is no gap to lose it in.
						</p>
					</li>
					<li>
						<span class="n">2</span>
						<h3>The API key ends up in the README</h3>
						<p>
							A badge is just an image, and GitHub fetches images anonymously — so the URL cannot
							carry your key. Each counter gets its own unguessable public id instead. That URL
							shows one number, cannot change it, and reveals nothing else you own.
						</p>
					</li>
					<li>
						<span class="n">3</span>
						<h3>The number counts caches, not code</h3>
						<p>
							Put a CDN in front of a page-hit counter and it either freezes or inflates. Reading
							never increments here. You increment from your own code, when the thing you actually
							care about happened.
						</p>
					</li>
				</ol>
			</section>

			<section class="band">
				<h2>Pairs with the others</h2>
				<p>
					Count the rows an export wrote, then ping <a href="/pulse/">Pulse</a> when it finishes.
					One number for the badge, one alert when the job stops.
				</p>
				<p class="cta">
					<a class="button" href="/howto/">How to, in curl</a>
					<a class="button secondary" href="/about/">What this is</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 2.5em;
		align-items: center;
		padding: 2em 0 1em;
	}
	.dim {
		color: var(--muted);
	}
	.lede {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 34em;
	}
	.cta {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		margin: 1.4em 0 0.6em;
	}
	.fineprint {
		font-size: 0.85rem;
	}
	.band {
		padding: 3em 0 0;
	}
	.band > p {
		max-width: 46em;
		color: var(--muted);
	}
	.small {
		font-size: 0.85rem;
	}
	.steps {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
		margin: 1.4em 0 0;
		padding: 0;
	}
	.steps li {
		border-top: 2px solid var(--border);
		padding-top: 1em;
	}
	.steps .n {
		font-family: var(--mono);
		color: var(--alive-ink);
		font-size: 0.8rem;
	}
	.steps h3 {
		font-size: 1.05rem;
		margin: 0.2em 0 0.4em;
	}
	.steps p {
		color: var(--muted);
		font-size: 0.93rem;
		margin: 0;
	}
	@media (max-width: 860px) {
		.hero,
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
