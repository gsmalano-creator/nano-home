---
import { CONTACT_EMAIL, GITHUB_URL, SITE_TITLE, X_HANDLE, X_URL } from "../consts";
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="line">
			<strong>{SITE_TITLE}</strong> · small, sharp APIs that do one thing · built on Cloudflare
			Workers
		</p>
		<p class="line muted">
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			· <a href={X_URL} rel="noopener" target="_blank">{X_HANDLE}</a>
			· <a href="/pulse/">Pulse</a>
			· <a href="/relay/">Relay</a>
			· <a href="/lock/">Lock</a>
			· <a href="/config/">Config</a>
			· <a href="/howto/">How to</a>
			· <a href="/pricing/">Pricing</a>
			· <a href="/about/">About</a>
		</p>
		<p class="line muted">&copy; {today.getFullYear()} nano-api</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		margin-top: 4em;
	}
	.inner {
		width: var(--maxw);
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 2.2em 1em 3em;
		text-align: center;
	}
	.line {
		margin: 0 0 0.5em;
		font-size: 0.9rem;
	}
	.line:last-child {
		margin-bottom: 0;
		font-size: 0.8rem;
	}
</style>
