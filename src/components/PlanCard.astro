---
import type { Plan } from "../consts";
import { CONTACT_EMAIL } from "../consts";

interface Props {
	plan: Plan;
	features?: string[];
}

const { plan, features = [] } = Astro.props;
const subject = encodeURIComponent(`NanoPulse: ${plan.name} plan`);
---

<div class:list={["card plan", { featured: plan.featured }]}>
	{plan.featured && <span class="badge">Most picked</span>}
	<h3>{plan.name}</h3>
	<p class="price">
		{plan.price}
		{plan.cadence && <span class="cadence">{plan.cadence}</span>}
	</p>
	<p class="quota">{plan.monitors}</p>
	<p class="tagline muted">{plan.tagline}</p>

	<a class:list={["button", { secondary: !plan.featured }]} href={`mailto:${CONTACT_EMAIL}?subject=${subject}`}>
		{plan.id === "custom" ? "Get in touch" : "Get an API key"}
	</a>

	{
		(features.length > 0 || plan.extras.length > 0) && (
			<ul>
				{features.map((f) => (
					<li>{f}</li>
				))}
				{plan.extras.map((f) => (
					<li>{f}</li>
				))}
			</ul>
		)
	}
</div>

<style>
	.plan {
		display: flex;
		flex-direction: column;
		position: relative;
	}
	.plan.featured {
		border-color: var(--alive-dim);
		box-shadow: 0 0 0 1px var(--alive-dim), var(--box-shadow);
	}
	.badge {
		position: absolute;
		top: -0.8em;
		left: 1.2em;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.25em 0.7em;
		border-radius: 999px;
		background: var(--alive);
		color: #05211a;
		font-weight: 700;
	}
	h3 {
		margin: 0.2em 0 0.3em;
	}
	.price {
		font-size: 2rem;
		font-weight: 700;
		margin: 0;
		letter-spacing: -0.02em;
	}
	.cadence {
		font-size: 0.85rem;
		font-weight: 400;
		color: var(--muted);
		margin-left: 0.3em;
	}
	.quota {
		font-family: var(--mono);
		font-size: 0.9rem;
		color: var(--alive);
		margin: 0.2em 0 0.6em;
	}
	.tagline {
		font-size: 0.92rem;
		min-height: 2.6em;
	}
	.button {
		text-align: center;
		margin: 0.4em 0 0.2em;
		white-space: nowrap;
		padding: 0.62em 0.9em;
		font-size: 0.95rem;
	}
	ul {
		list-style: none;
		margin: 1.2em 0 0;
		padding: 1.2em 0 0;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
	li {
		position: relative;
		padding-left: 1.5em;
		margin-bottom: 0.5em;
		color: var(--muted);
	}
	li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--alive);
	}
</style>
