---
import HeaderLink from "./HeaderLink.astro";
import { GITHUB_URL, SITE_TITLE, X_URL } from "../consts";
---

<header>
	<nav>
		<a class="brand" href="/">
			<svg viewBox="0 0 28 16" width="28" height="16" aria-hidden="true">
				<path
					d="M0 8 H6 l2.5 -6 l2.5 12 l2.5 -6 H28"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			<HeaderLink href="/pulse/">Pulse</HeaderLink>
			<HeaderLink href="/relay/">Relay</HeaderLink>
			<HeaderLink href="/lock/">Lock</HeaderLink>
			<HeaderLink href="/howto/">How to</HeaderLink>
			<HeaderLink href="/pricing/">Pricing</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<a href={X_URL} rel="noopener" target="_blank">
				<span class="sr-only">Contact on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
						d="M9.52 6.77 15.48 0h-1.41L8.9 5.88 4.76 0H0l6.25 8.9L0 16h1.41l5.46-6.21L11.24 16H16L9.52 6.77Zm-2.3 2.61-.84-1.18L1.92 1.04h2.17l3.4 4.77.85 1.19 4.68 6.56h-2.17L7.22 9.38Z"
					></path></svg
				>
			</a>
			<a href={GITHUB_URL} rel="noopener" target="_blank">
				<span class="sr-only">Source on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(11, 15, 20, 0.82);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: var(--maxw);
		max-width: calc(100% - 2em);
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		padding: 0.5em 1em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		font-family: var(--mono);
		letter-spacing: -0.02em;
	}
	.brand svg {
		color: var(--alive);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.4em;
	}
	.links :global(a) {
		padding: 0.5em 0.6em;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		border-radius: 8px;
	}
	.links :global(a:hover) {
		color: var(--text);
		background: var(--surface-2);
	}
	.links :global(a.active) {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 560px) {
		.links :global(a) {
			padding: 0.5em 0.35em;
			font-size: 0.88rem;
		}
	}
</style>
