---
import HeaderLink from "./HeaderLink.astro";
import { GITHUB_URL, SITE_TITLE, X_URL } from "../consts";
---

<header>
	<nav>
		<a class="brand" href="/">
			<svg viewBox="0 0 28 16" width="28" height="16" aria-hidden="true">
				<path
					d="M0 8 H6 l2.5 -6 l2.5 12 l2.5 -6 H28"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<button class="burger" type="button" aria-controls="site-nav" aria-expanded="false">
			<span class="sr-only">Menu</span>
			<span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
		</button>
		<div class="links" id="site-nav">
			<HeaderLink href="/pulse/">Pulse</HeaderLink>
			<HeaderLink href="/relay/">Relay</HeaderLink>
			<HeaderLink href="/lock/">Lock</HeaderLink>
			<HeaderLink href="/config/">Config</HeaderLink>
			<HeaderLink href="/count/">Count</HeaderLink>
			<HeaderLink href="/howto/">How to</HeaderLink>
			<HeaderLink href="/pricing/">Pricing</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<span class="icons">
				<a href={X_URL} rel="noopener" target="_blank">
					<span class="sr-only">Contact on X</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
						><path
							fill="currentColor"
							d="M9.52 6.77 15.48 0h-1.41L8.9 5.88 4.76 0H0l6.25 8.9L0 16h1.41l5.46-6.21L11.24 16H16L9.52 6.77Zm-2.3 2.61-.84-1.18L1.92 1.04h2.17l3.4 4.77.85 1.19 4.68 6.56h-2.17L7.22 9.38Z"
						></path></svg
					>
				</a>
				<a href={GITHUB_URL} rel="noopener" target="_blank">
					<span class="sr-only">Source on GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</span>
		</div>
	</nav>
</header>

<script is:inline>
	// Marks the document before first paint, so the collapsed menu only ever
	// applies where there is script to open it again.
	document.documentElement.classList.add("has-js");
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(11, 15, 20, 0.82);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 100%;
		max-width: var(--maxw);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.2em 1em;
		padding: 0.5em 1em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		font-family: var(--mono);
		letter-spacing: -0.02em;
	}
	.brand svg {
		color: var(--alive);
	}
	.links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0 0.4em;
		min-width: 0;
	}
	.links :global(a) {
		padding: 0.5em 0.6em;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		border-radius: 8px;
	}
	.links :global(a:hover) {
		color: var(--text);
		background: var(--surface-2);
	}
	.links :global(a.active) {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}
	.icons {
		display: inline-flex;
		align-items: center;
	}

	/* The burger exists only on narrow screens; see the media query below. */
	.burger {
		display: none;
		background: none;
		border: 1px solid transparent;
		border-radius: 10px;
		color: var(--muted);
		padding: 0.5em;
		cursor: pointer;
		line-height: 0;
	}
	.burger:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	.burger:focus-visible {
		outline: 2px solid var(--alive-dim);
		outline-offset: 2px;
	}
	.bars {
		display: block;
		width: 20px;
		height: 14px;
		position: relative;
	}
	.bars i {
		position: absolute;
		left: 0;
		right: 0;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.18s ease, opacity 0.18s ease;
	}
	.bars i:nth-child(1) {
		top: 0;
	}
	.bars i:nth-child(2) {
		top: 6px;
	}
	.bars i:nth-child(3) {
		top: 12px;
	}
	/* Open: the outer bars meet in the middle and cross, the middle one goes. */
	.burger[aria-expanded="true"] .bars i:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.burger[aria-expanded="true"] .bars i:nth-child(2) {
		opacity: 0;
	}
	.burger[aria-expanded="true"] .bars i:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	@media (max-width: 820px) {
		nav {
			flex-wrap: nowrap;
			padding: 0.4em 0.9em;
		}
		:global(html.has-js) .burger {
			display: block;
		}
		:global(html.has-js) .links {
			display: none;
			position: absolute;
			left: 0;
			right: 0;
			top: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.4em 0.9em 0.9em;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
		}
		:global(html.has-js) .links.open {
			display: flex;
		}
		.links :global(a) {
			padding: 0.7em 0.4em;
			font-size: 1rem;
		}
		:global(html.has-js) .links :global(a) {
			border-bottom: 1px solid var(--border);
			border-radius: 0;
		}
		.icons {
			gap: 0.6em;
			padding-top: 0.7em;
		}
		:global(html.has-js) .icons :global(a) {
			border-bottom: none;
		}
	}
</style>

<script>
	const burger = document.querySelector<HTMLButtonElement>("header .burger");
	const links = document.getElementById("site-nav");

	if (burger && links) {
		const setOpen = (open: boolean) => {
			burger.setAttribute("aria-expanded", String(open));
			links.classList.toggle("open", open);
		};

		burger.addEventListener("click", () => {
			setOpen(burger.getAttribute("aria-expanded") !== "true");
		});

		// Escape closes it and puts focus back where the finger was.
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && burger.getAttribute("aria-expanded") === "true") {
				setOpen(false);
				burger.focus();
			}
		});

		// A tap anywhere else is a dismissal, not a mystery.
		document.addEventListener("click", (event) => {
			const target = event.target as Node;
			if (!links.contains(target) && !burger.contains(target)) setOpen(false);
		});

		// Rotating the phone can widen past the breakpoint, where the panel is
		// laid out inline again; leaving it "open" would then be meaningless.
		addEventListener("resize", () => {
			if (innerWidth > 820) setOpen(false);
		});
	}
</script>
